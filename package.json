{
  "name": "@abelxiaoxing/cadence",
  "version": "2.0.17",
  "description": "Shared Pi task workspace: native terminal and WebUI, persistent service, checks and human review.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "abel",
    "workflow",
    "cadence"
  ],
  "files": [
    "skills",
    "config",
    "agents",
    "src/agent-panel-cadence.ts",
    "src/agent-panel-model.ts",
    "src/agent-panel.ts",
    "src/cadence-service.mjs",
    "src/index.ts",
    "src/native-build.ts",
    "src/native-client.ts",
    "src/native-export.ts",
    "src/native-history.ts",
    "src/operator-cli.mjs",
    "src/plan-proposal.ts",
    "src/sdk-worker.mjs",
    "src/service-cli.mjs",
    "src/service-client.ts",
    "src/service-contract.ts",
    "src/service-host.mjs",
    "src/service-http-client.ts",
    "src/service-wire.ts",
    "src/service/contracts/active.ts",
    "src/service/contracts/budget.ts",
    "src/service/contracts/build.ts",
    "src/service/contracts/capture.ts",
    "src/service/contracts/core.ts",
    "src/service/contracts/current.ts",
    "src/service/contracts/domain.ts",
    "src/service/contracts/history.ts",
    "src/service/contracts/models.ts",
    "src/service/coordination.ts",
    "src/service/private-files.ts",
    "src/startup-card.ts",
    "src/task-shell.ts",
    "src/task-store.ts",
    "src/task-types.ts",
    "src/verification-diagnostics.ts",
    "src/worker-capture.mjs",
    "src/worker-public.mjs",
    "src/worker-redaction.mjs",
    "src/worker-tools.mjs",
    "web/dist",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "src/conversation-context.mjs",
    "src/conversation-resources.mjs",
    "src/service/contracts/workbench.ts"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "pack:check": "node scripts/pack-check.mjs",
    "traceability:check": "node scripts/traceability-check.mjs",
    "verify": "bun run check && bun run check:web && bun run build:web:check && bun run lint && bun run check:agents && bun run test && bun run test:web && bun run test:browser && bun run pack:check",
    "check": "node scripts/check-syntax.mjs && bun scripts/build-operator.mjs --check && bun scripts/build-service.mjs --check && tsc --noEmit",
    "lint": "biome check . && rumdl check .",
    "test": "vitest run",
    "test:target": "vitest run",
    "check:agents": "node scripts/check-agents.mjs",
    "doctor": "node src/operator-cli.mjs doctor",
    "runs": "node src/operator-cli.mjs runs",
    "build:operator": "bun scripts/build-operator.mjs",
    "build:service": "bun scripts/build-service.mjs",
    "check:web": "tsc -p web/tsconfig.json && tsc -p web/tsconfig.config.json",
    "test:web": "node --test test/web/task-entry.node.mjs && vitest run --config web/vitest.config.ts",
    "build:web": "node scripts/build-web.mjs",
    "build:web:check": "node scripts/build-web.mjs --check",
    "test:web:assets-browser": "bun run test:browser",
    "build:check": "bun scripts/build-operator.mjs --check && bun scripts/build-service.mjs --check && bun run build:web:check",
    "test:service": "vitest run --config test/service.config.ts",
    "test:browser": "vitest run --config web/browser.config.ts",
    "check:notices": "node scripts/audit-notices.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^22.15.3",
    "rumdl": "^0.2.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@types/ws": "8.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-breaks": "4.0.0",
    "remark-math": "6.0.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "micromark-util-types": "2.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-math": "3.0.0",
    "vis-timeline": "8.5.4",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abelxiaoxing/cadence.git"
  },
  "homepage": "https://github.com/abelxiaoxing/cadence",
  "bugs": {
    "url": "https://github.com/abelxiaoxing/cadence/issues"
  },
  "dependencies": {
    "undici": "8.9.0",
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3"
  },
  "bin": {
    "cadence": "./src/service-cli.mjs",
    "cadence-service": "./src/cadence-service.mjs"
  }
}
