{
  "name": "@abelxiaoxing/cadence",
  "version": "1.8.4",
  "description": "Explicit terminal-only Pi workflow assistant: plan, edit, check and human review.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "pi-package",
    "abel",
    "workflow",
    "cadence"
  ],
  "files": [
    "skills",
    "config",
    "src",
    "agents",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "postinstall": "node src/install-config.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "traceability:check": "node scripts/traceability-check.mjs",
    "verify": "bun run check && bun run lint && bun run test && bun run pack:check",
    "check": "node scripts/check-syntax.mjs && bun scripts/build-operator.mjs --check && tsc --noEmit",
    "lint": "biome check . && rumdl check .",
    "test": "vitest run --no-file-parallelism",
    "test:target": "vitest run",
    "check:agents": "node scripts/check-agents.mjs",
    "doctor": "node src/operator-cli.mjs doctor",
    "runs": "node src/operator-cli.mjs runs",
    "build:operator": "bun scripts/build-operator.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^22.15.3",
    "rumdl": "^0.2.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@earendil-works/pi-ai": "0.84.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abelxiaoxing/cadence.git"
  },
  "homepage": "https://github.com/abelxiaoxing/cadence",
  "bugs": {
    "url": "https://github.com/abelxiaoxing/cadence/issues"
  }
}
