{
  "routes": {
    "parent": {
      "kind": "inherited",
      "capabilities": {
        "roles": [
          "design-explorer",
          "implementation-worker",
          "diagnosis-worker"
        ],
        "dialects": [
          "openai-completions",
          "openai-responses",
          "anthropic-messages"
        ],
        "contextWindow": 256000,
        "maxTokens": 128000
      }
    },
    "custom-worker": {
      "kind": "custom",
      "url": "https://example.invalid/v1",
      "model": "example-model",
      "dialect": "openai-responses",
      "apiKeyEnv": "CADENCE_CUSTOM_WORKER_API_KEY",
      "capabilities": {
        "roles": ["implementation-worker"],
        "dialects": ["openai-responses"],
        "contextWindow": 256000,
        "maxTokens": 128000
      }
    }
  },
  "roles": {
    "design-explorer": ["parent"],
    "implementation-worker": ["custom-worker", "parent"],
    "diagnosis-worker": ["parent"]
  }
}
