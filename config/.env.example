# Copy to <project>/.pi/cadence/.env or ~/.pi/agent/cadence/.env.
# The project file wins as a whole file; values are not merged or interpolated.

# Optional Subagent endpoint. Any non-empty key commits the whole layer, which
# then requires MODEL and API_URL. Empty API/bounds use the documented defaults.
SUBAGENT_API_URL=
SUBAGENT_API_KEY=
SUBAGENT_MODEL=
# Dialect: openai-completions (default), openai-responses, anthropic-messages.
SUBAGENT_API=
# Internal defaults: context window 256000, max output tokens 128000.
SUBAGENT_CONTEXT_WINDOW=
SUBAGENT_MAX_TOKENS=

# Per-role layers use the same six suffixes and override the global layer whole:
# SUBAGENT_<ROLE>_<SUFFIX>, where ROLE is DESIGN_EXPLORER, CONTRACT_REVIEWER,
# IMPLEMENTATION_WORKER, or DIAGNOSIS_WORKER. Partial/invalid layers fail closed.

CONTEXT7_API_URL=https://context7.com/api/v2
CONTEXT7_API_KEY=

GROK_API_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_MODEL=grok-4.20-non-reasoning

# Tavily is enabled by default when TAVILY_API_KEY is set; set to false to opt out.
TAVILY_ENABLED=true
TAVILY_API_URL=https://api.tavily.com
TAVILY_API_KEY=
