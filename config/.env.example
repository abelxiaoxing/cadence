# Copy to <project>/.pi/pi-abel-workflow/.env or ~/.pi/agent/pi-abel-workflow/.env.
# The project file wins as a whole file; values are not merged or interpolated.

CONTEXT7_API_URL=https://context7.com/api/v2
CONTEXT7_API_KEY=

GROK_API_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_MODEL=grok-4.20-non-reasoning

# Tavily is enabled by default when TAVILY_API_KEY is set; set to false to opt out.
TAVILY_ENABLED=true
TAVILY_API_URL=https://api.tavily.com
TAVILY_API_KEY=
