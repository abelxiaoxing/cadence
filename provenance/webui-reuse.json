        "web/src/history/download-export.ts",
        "web/src/components/history/ExportDialog.tsx"
      ],
      "modifications": "Reuse debounced request correlation, keyboard/result sections, exact DOM-range scroll/highlight helpers, fragment links and anchor download interaction. Replace ambient files/projects/plugins/session restoration with immutable scoped hits. Data/progress/snapshot handled in new reader adapters. No token storage/URL replay, timestamp guesses or giant Blob export. Native download explicitly requested/unverified; local page highlighting capped and labeled separately from complete durable search."
    },
    {
      "id": "timeline",
      "sources": ["plugins/run-trace/client/entry.mjs"],
      "destinations": [
        "web/src/timeline/timeline-client.mjs",
